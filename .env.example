# Q-BIT Platform Environment Variables
# Copy this to ../cryptoAi/.env and fill in your API keys

# ---- Exchange API Keys ----
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_here

ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Optional: other brokers
COINBASE_API_KEY=
COINBASE_SECRET_KEY=
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=
IBKR_API_KEY=

# ---- Database ----
MONGO_URI=mongodb://mongo:27017

# ---- ML Pipeline Config ----
# How often to refresh signals (minutes)
REFRESH_INTERVAL=15

# Assets to track (comma-separated)
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
STOCK_SYMBOLS=NVDA,TSLA,AAPL,MSFT,GOOGL,EXPE

# Risk parameters
VOLATILITY_TARGET=0.35
MAX_POSITION_SIZE=0.15
CASH_BUFFER=0.07

# ---- Logging ----
LOG_LEVEL=INFO
